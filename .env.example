# Telegram BotFather'dan olingan bot tokeni
BOT_TOKEN=

# Hosting bergan public HTTPS manzil (masalan: https://forma-app.onrender.com)
APP_URL=

# OpenAI API kaliti (faqat serverda, hech qachon frontendga yoki Git'ga tushmasin)
OPENAI_API_KEY=

# Ishlatiladigan OpenAI modeli
OPENAI_MODEL=gpt-4o-mini

# Server porti (Render o'zi PORT'ni beradi, lokal test uchun 3000 ishlatiladi)
PORT=3000
